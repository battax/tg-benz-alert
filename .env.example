# Creato con @BotFather. Non committare mai il token reale.
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Modalità canale opzionale (oltre agli alert privati personalizzati).
# Per un canale pubblico: @nome_canale. Per uno privato: ID numerico -100...
CHANNEL_ALERT_ENABLED=true
TELEGRAM_CHAT_ID=@benzina_piacenza_alert

# Centro di Quarto, Gossolengo (PC)
CENTER_LAT=44.9969
CENTER_LON=9.66388
RADIUS_KM=15

# Chat che riceve gli avvisi quando i controlli falliscono di fila.
# Lascia vuoto per disattivarli. Il tuo ID lo trovi scrivendo a @userinfobot.
ADMIN_CHAT_ID=

# Invia un alert quando la migliore benzina self è uguale o inferiore alla soglia.
PRICE_THRESHOLD=1.930
# fixed: usa PRICE_THRESHOLD. auto: soglia ricavata dallo storico del canale.
THRESHOLD_MODE=fixed
MIN_PRICE_DROP=0.005
MAX_RESULTS=5
REQUIRE_TODAY_UPDATE=true

# Ogni giorno alle 07:00 e alle 22:00, ora italiana.
CRON_SCHEDULE=0 7,22 * * *
# Il motore utenti controlla ogni minuto chi ha un alert previsto in quell'ora.
USER_SCHEDULER_CRON=* * * * *
TIMEZONE=Europe/Rome
RUN_ON_START=false

# true: stampa il messaggio senza inviarlo a Telegram.
DRY_RUN=false

# Percorso persistente nel container.
STATE_FILE=/app/data/state.json
SUBSCRIBERS_FILE=/app/data/subscribers.json
BOT_STATE_FILE=/app/data/bot-state.json

# API live ufficiale dell'Osservaprezzi MIMIT.
MIMIT_LIVE_API_URL=https://carburanti.mise.gov.it/ospzApi
